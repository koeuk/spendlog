# SpendLog — production .env template.
# Copy to /var/www/spendlog/.env, fill the blanks, then run:
#   php artisan key:generate && php artisan migrate --force && php artisan db:seed --force

APP_NAME=SpendLog
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spendlog
DB_USERNAME=spendlog
DB_PASSWORD=

# The owner account, created on first `db:seed`. Set a strong password BEFORE
# seeding — the fallback in config/spendlog.php is not production-safe.
SUPER_ADMIN_EMAIL=koeukkos@gmail.com
SUPER_ADMIN_NAME=Koeuk
SUPER_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is only used for password resets; log driver disables real sending
# until an SMTP account is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
